<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="<%- url_for('/') %>">
      <span class="site-brand-mark" aria-hidden="true"></span>
      <span class="site-brand-name"><%= config.title %></span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <% Object.keys(theme.menu || {}).forEach(function (name) { var path = theme.menu[name]; %>
      <a class="site-nav-link<% if (is_current(path)) { %> is-active<% } %>" href="<%- url_for(path) %>"><%= name %></a>
      <% }); %>
    </nav>
    <%- partial('_partial/theme-switch') %>
  </div>
</header>
